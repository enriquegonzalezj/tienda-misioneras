# Copia este archivo como .env y rellena los valores. El .env nunca se sube a git.
# En Render, las variables las define render.yaml y las secretas se escriben en el panel.

# Backend
DATABASE_URL=postgresql://USUARIO:CONTRASENA@localhost:5432/tienda_dev
FLASK_APP=src/app.py
# 1 solo en local. En Render es 0: la consola de depuración permite ejecutar código.
FLASK_DEBUG=1

# Llave que firma las sesiones (JWT). Mínimo 32 caracteres; distinta en local y en Render.
# Genera una con: pipenv run python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Solo en local (http): false. En Render no se pone y queda activado (cookie solo por HTTPS).
JWT_COOKIE_SECURE=false

# Dirección pública de la tienda, sin barra final. Se usa en los enlaces de los correos.
# En local, la del frontend de Vite; en Render, la dirección real de la tienda.
PUBLIC_BASE_URL=http://localhost:3000

# Proxies de confianza delante de Flask (ver src/app.py). En local no se pone (vale 0).
# En Render se pone el número medido tras publicar.
# TRUSTED_PROXY_HOPS=

# Imágenes (Cloudinary) y correo (Resend). En local se dejan vacías hasta usarlas.
CLOUDINARY_URL=
RESEND_API_KEY=
