# Copia este archivo como .env y rellena los valores. El .env nunca se sube a git.
# En Render, estas variables se ponen en el panel del servicio (tarea 1.4).

# Backend
DATABASE_URL=postgresql://USUARIO:CONTRASENA@localhost:5432/tienda_dev
FLASK_APP=src/app.py
FLASK_DEBUG=1

# Llave que firma las sesiones (JWT). Mínimo 32 caracteres; distinta en local y en Render.
# Genera una con: pipenv run python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Solo en local (http): false. En Render no se pone y queda activado (cookie solo por HTTPS).
JWT_COOKIE_SECURE=false
