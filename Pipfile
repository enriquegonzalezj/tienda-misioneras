[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[dev-packages]

[packages]
flask = "~=3.1"
flask-sqlalchemy = "~=3.1"
flask-migrate = "~=4.1"
sqlalchemy = "~=2.0.44"
psycopg2-binary = "~=2.9"
python-dotenv = "~=1.2"
gunicorn = "~=23.0"
cloudinary = "~=1.44"
typing-extensions = "*"
colorama = "*"
packaging = "*"
flask-jwt-extended = "~=4.7"
flask-limiter = "~=4.1"

[requires]
python_version = "3.13"

[scripts]
start = "flask run -p 3001 -h 127.0.0.1"
init = "flask db init"
migrate = "flask db migrate"
upgrade = "flask db upgrade"
downgrade = "flask db downgrade"
