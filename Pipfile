[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[dev-packages]

[packages]
flask = "~=3.1"
flask-sqlalchemy = "~=3.1"
flask-migrate = "~=4.1"
sqlalchemy = "~=2.0.44"
psycopg2-binary = "~=2.9"
python-dotenv = "~=1.2"
gunicorn = "~=23.0"
cloudinary = "~=1.44"
flask-jwt-extended = "==4.6.0"
typing-extensions = "*"
colorama = "*"
